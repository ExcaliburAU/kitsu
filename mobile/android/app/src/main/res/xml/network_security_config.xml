<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow cleartext for local/dev homeservers; production HS uses HTTPS. -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
